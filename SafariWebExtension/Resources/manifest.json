{
  "manifest_version": 3,
  "name": "Send to X4",
  "version": "0.1.0",
  "description": "Send essays and articles to your Xteink X4 e-reader as beautifully formatted EPUBs.",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "17.0"
    }
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Send to X4",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/Readability.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
